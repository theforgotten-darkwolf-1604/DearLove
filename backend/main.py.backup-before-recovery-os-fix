# =========================================================

@app.post("/matches/create")
def create_match(
    user_id: int = Depends(get_current_user),
):
    db = SessionLocal()

    try:
        likes = db.query(Like).filter(
            Like.user_id == user_id
        ).all()

        for like in likes:
            mutual = db.query(Like).filter(
                Like.user_id == like.liked_user_id,
                Like.liked_user_id == user_id,
            ).first()

            if not mutual:
                continue

            existing = db.query(Match).filter(
                (
                    (Match.user1_id == user_id)
                    & (Match.user2_id == like.liked_user_id)
                )
                |
                (
                    (Match.user1_id == like.liked_user_id)
                    & (Match.user2_id == user_id)
                )
            ).first()

            if existing:
                return {
                    "message": "Match already exists",
                    "match_id": existing.id,
                }

            new_match = Match(
                user1_id=user_id,
                user2_id=like.liked_user_id,
            )

            db.add(new_match)
            db.commit()
            db.refresh(new_match)

            return {
                "message": "It's a match! ",
                "match_id": new_match.id,
                "user1_id": new_match.user1_id,
                "user2_id": new_match.user2_id,
            }

        return {
            "message": "No mutual like found",
        }

    finally:
        db.close()


