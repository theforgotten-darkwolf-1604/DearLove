active_connections = {}


@app.websocket("/ws/{user_id}")
async def websocket_endpoint(
    websocket: WebSocket,
    user_id: int,
):
    await websocket.accept()

    active_connections[user_id] = websocket

    try:
        while True:
            data = await websocket.receive_json()

            receiver_id = data.get("receiver_id")
            content = data.get("content")

            if not receiver_id or not content:
                continue

            try:
                receiver_id = int(receiver_id)
            except Exception:
                continue

            content = str(content).strip()

            if not content:
                continue

            db = SessionLocal()

            try:
                receiver = user_exists(db, receiver_id)

                if not receiver:
                    continue

                message = Message(
                    sender_id=user_id,
                    receiver_id=receiver_id,
                    content=content,
                    is_read=False,
                )

                db.add(message)
                db.commit()
                db.refresh(message)

                message_data = {
                    "message_id": message.id,
                    "sender_id": message.sender_id,
                    "receiver_id": message.receiver_id,
                    "content": message.content,
                    "is_read": message.is_read,
                    "created_at": (
                        message.created_at.isoformat()
                        if message.created_at
                        else None
                    ),
                }

            finally:
                db.close()

            receiver_socket = active_connections.get(receiver_id)

            if receiver_socket:
                try:
                    await receiver_socket.send_json(
                        message_data
                    )
                except Exception:
                    if active_connections.get(receiver_id) == receiver_socket:
                        del active_connections[receiver_id]

            await websocket.send_json(message_data)

    except WebSocketDisconnect:
        if active_connections.get(user_id) == websocket:
            del active_connections[user_id]

    except Exception:
        if active_connections.get(user_id) == websocket:
            del active_connections[user_id]


