@app.delete("/profile")
def delete_profile(
    user_id: int = Depends(get_current_user),
):
    db = SessionLocal()

    try:
        user = db.query(User).filter(
            User.id == user_id
        ).first()

        if not user:
            raise HTTPException(
                status_code=404,
                detail="User account not found",
            )

        # -------------------------------------------------
        # Delete all data owned by / associated with user
        # -------------------------------------------------

        # Profile
        db.query(Profile).filter(
            Profile.user_id == user_id
        ).delete(synchronize_session=False)

        # Likes sent by this user or received by this user
        db.query(Like).filter(
            (Like.user_id == user_id) |
            (Like.liked_user_id == user_id)
        ).delete(synchronize_session=False)

        # Matches involving this user
        db.query(Match).filter(
            (Match.user1_id == user_id) |
            (Match.user2_id == user_id)
        ).delete(synchronize_session=False)

        # Messages sent or received by this user
        db.query(Message).filter(
            (Message.sender_id == user_id) |
            (Message.receiver_id == user_id)
        ).delete(synchronize_session=False)

        # Notifications belonging to this user
        db.query(Notification).filter(
            Notification.user_id == user_id
        ).delete(synchronize_session=False)

        # Connections sent or received by this user
        db.query(Connection).filter(
            (Connection.requester_id == user_id) |
            (Connection.receiver_id == user_id)
        ).delete(synchronize_session=False)

        # Saved locations
        db.query(Location).filter(
            Location.user_id == user_id
        ).delete(synchronize_session=False)

        # Location shares owned by or shared with this user
        db.query(LocationShare).filter(
            (LocationShare.owner_id == user_id) |
            (LocationShare.viewer_id == user_id)
        ).delete(synchronize_session=False)

        # Emergency contacts
        db.query(EmergencyContact).filter(
            EmergencyContact.user_id == user_id
        ).delete(synchronize_session=False)

        # Call history
        db.query(CallHistory).filter(
            (CallHistory.caller_id == user_id) |
            (CallHistory.receiver_id == user_id)
        ).delete(synchronize_session=False)

        # Block relationships
        db.query(BlockedUser).filter(
            (BlockedUser.blocker_id == user_id) |
            (BlockedUser.blocked_id == user_id)
        ).delete(synchronize_session=False)

        # Reports filed by or against this user
        db.query(UserReport).filter(
            (UserReport.reporter_id == user_id) |
            (UserReport.reported_id == user_id)
        ).delete(synchronize_session=False)

        # User settings
        db.query(UserSettings).filter(
            UserSettings.user_id == user_id
        ).delete(synchronize_session=False)

        # Admin record, if the account is an administrator
        db.query(AdminUser).filter(
            AdminUser.user_id == user_id
        ).delete(synchronize_session=False)

        # Suspension records
        db.query(UserSuspension).filter(
            UserSuspension.user_id == user_id
        ).delete(synchronize_session=False)

        # Finally delete the actual account
        db.delete(user)

        db.commit()

        return {
            "message": "Account deleted successfully",
        }

    except HTTPException:
        db.rollback()
        raise

    except Exception:
        db.rollback()
        raise HTTPException(
            status_code=500,
            detail="Account deletion failed",
        )

    finally:
        db.close()

