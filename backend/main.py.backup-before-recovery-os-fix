@app.post("/connections/request")
def send_connection_request(
    receiver_id: int,
    user_id: int = Depends(get_current_user),
):
    db = SessionLocal()

    try:
        if receiver_id == user_id:
            raise HTTPException(
                status_code=400,
                detail="You cannot connect with yourself",
            )

        receiver = user_exists(db, receiver_id)

        if not receiver:
            raise HTTPException(
                status_code=404,
                detail="User not found",
            )

        existing = db.query(Connection).filter(
            (
                (Connection.requester_id == user_id)
                & (Connection.receiver_id == receiver_id)
            )
            |
            (
                (Connection.requester_id == receiver_id)
                & (Connection.receiver_id == user_id)
            )
        ).first()

        if existing:
            if (
                existing.requester_id == user_id
                and existing.status == "pending"
            ):
                raise HTTPException(
                    status_code=400,
                    detail="Connection request already sent",
                )

            if existing.status == "accepted":
                raise HTTPException(
                    status_code=400,
                    detail="You are already connected",
                )

            if existing.status == "rejected":
                existing.requester_id = user_id
                existing.receiver_id = receiver_id
                existing.status = "pending"

                db.commit()
                db.refresh(existing)

                return {
                    "message": "Connection request sent successfully",
                    "connection_id": existing.id,
                    "receiver_id": receiver_id,
                    "status": existing.status,
                }

            raise HTTPException(
                status_code=400,
                detail="Connection request already exists",
            )

        connection = Connection(
            requester_id=user_id,
            receiver_id=receiver_id,
            status="pending",
        )

        db.add(connection)
        db.commit()
        db.refresh(connection)

        current_user = user_exists(db, user_id)

        create_notification(
            db,
            receiver_id,
            "connection",
            "New Connection Request ",
            f"{current_user.username} wants to connect with you.",
        )

        return {
            "message": "Connection request sent successfully",
            "connection_id": connection.id,
            "receiver_id": receiver_id,
            "status": connection.status,
        }

    finally:
        db.close()


