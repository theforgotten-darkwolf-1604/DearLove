@app.post("/likes")
def like_user(
    liked_user_id: int,
    user_id: int = Depends(get_current_user),
):
    db = SessionLocal()

    try:
        if liked_user_id == user_id:
            raise HTTPException(
                status_code=400,
                detail="You cannot like yourself",
            )

        target_user = user_exists(db, liked_user_id)

        if not target_user:
            raise HTTPException(
                status_code=404,
                detail="User not found",
            )

        existing_like = db.query(Like).filter(
            Like.user_id == user_id,
            Like.liked_user_id == liked_user_id,
        ).first()

        if existing_like:
            raise HTTPException(
                status_code=400,
                detail="You already liked this user",
            )

        current_user = user_exists(db, user_id)

        new_like = Like(
            user_id=user_id,
            liked_user_id=liked_user_id,
        )

        db.add(new_like)
        db.commit()
        db.refresh(new_like)

        create_notification(
            db,
            liked_user_id,
            "like",
            "New Like ",
            f"{current_user.username} liked you.",
        )

        mutual_like = db.query(Like).filter(
            Like.user_id == liked_user_id,
            Like.liked_user_id == user_id,
        ).first()

        if mutual_like:
            existing_match = db.query(Match).filter(
                (
                    (Match.user1_id == user_id)
                    & (Match.user2_id == liked_user_id)
                )
                |
                (
                    (Match.user1_id == liked_user_id)
                    & (Match.user2_id == user_id)
                )
            ).first()

            if not existing_match:
                new_match = Match(
                    user1_id=user_id,
                    user2_id=liked_user_id,
                )

                db.add(new_match)
                db.commit()
                db.refresh(new_match)

                create_notification(
                    db,
                    user_id,
                    "match",
                    "It's a Match! ",
                    f"You matched with {target_user.username}.",
                )

                create_notification(
                    db,
                    liked_user_id,
                    "match",
                    "It's a Match! ",
                    f"You matched with {current_user.username}.",
                )

                return {
                    "message": "It's a match! ",
                    "like_id": new_like.id,
                    "match_id": new_match.id,
                    "user_id": user_id,
                    "matched_user_id": liked_user_id,
                }

        return {
            "message": "User liked successfully",
            "like_id": new_like.id,
            "user_id": user_id,
            "liked_user_id": liked_user_id,
        }

    finally:
        db.close()


